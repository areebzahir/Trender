# Trender AI Furniture Expert - Environment Variables

# Qloo API Configuration
# Get your API key from: https://qloo.com/developers
VITE_QLOO_API_KEY=your_qloo_api_key_here

# Google Gemini API Configuration  
# Get your API key from: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Configuration (Optional - for enhanced AI features)
# Get your API key from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Development Settings
NODE_ENV=development
VITE_APP_NAME=Trender
VITE_APP_VERSION=1.0.0

# Production Settings (uncomment for production builds)
# NODE_ENV=production
# VITE_API_BASE_URL=https://api.trender.com