# Trender AI Furniture Expert - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. It is already in .gitignore.

# -------------------------------------------------------
# Supabase — FRONTEND (safe to expose, anon/public key)
# -------------------------------------------------------
VITE_SUPABASE_URL=https://hbehelm qrzrnlmnhryfu.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# -------------------------------------------------------
# Supabase — BACKEND / EDGE FUNCTIONS ONLY
# NEVER prefix with VITE_ — never expose to browser
# Used only in Supabase Edge Functions via Deno.env.get()
# -------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# -------------------------------------------------------
# Embedding model config (used in ingestion layer)
# Options: openai | gemini
# OpenAI dims: 1536 (text-embedding-3-small or ada-002)
# Gemini dims:  768 (embedding-001)
# -------------------------------------------------------
# EMBEDDING_PROVIDER=openai
# EMBEDDING_DIMENSIONS=1536

# -------------------------------------------------------
# API Keys
# -------------------------------------------------------
# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Stability AI API Configuration (for room preview generation)
# Get your API key from: https://platform.stability.ai/
STABILITY_API_KEY=your_stability_api_key_here

# Qloo API
VITE_QLOO_API_KEY=your_qloo_api_key_here

# -------------------------------------------------------
# Apify (server-side ingestion only, never VITE_ prefix)
# -------------------------------------------------------
# APIFY_API_TOKEN=your_apify_token_here

# -------------------------------------------------------
# SerpApi (server-side ingestion only)
# -------------------------------------------------------
# SERPAPI_KEY=your_serpapi_key_here

# -------------------------------------------------------
# Storage Configuration
# Options: "local" (development) | "s3" | "cloudinary"
# -------------------------------------------------------
STORAGE_PROVIDER=local

# Development Settings
NODE_ENV=development
VITE_APP_NAME=Trender
VITE_APP_VERSION=1.0.0
